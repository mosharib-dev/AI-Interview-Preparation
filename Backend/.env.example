# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/ai-interview-prep

# Secret used to sign/verify JWTs — use a long, random string in production
JWT_SECRET=replace-with-a-long-random-secret

# Google GenAI (Gemini) API key — used to generate interview reports/resumes
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# Frontend origin, used for CORS (must match exactly, no trailing slash)
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development

# Port the backend listens on (optional, defaults to 3000)
PORT=3000